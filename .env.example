# Super Agent Deal Finder — copy to .env.local and fill in.
# NEVER commit real values or paste them into chat. All are read on the server only.
# Leave PROPERTY_RADAR_API_KEY empty to run in demo mode.

# PropertyRadar — live parcel data. Empty = demo mode.
PROPERTY_RADAR_API_KEY=

# Anthropic — one-line score reasons and teardown photo review.
ANTHROPIC_API_KEY=

# Supabase — database + sign-in (connected once keys are provided).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — live street and aerial view on the property card.
# Enable "Street View Static API" and "Maps Static API" for this key.
GOOGLE_MAPS_API_KEY=
