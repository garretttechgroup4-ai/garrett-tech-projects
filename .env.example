# Super Agent Deal Finder — copy to .env.local and fill in.
# NEVER commit real values or paste them into chat.
# Leave PROPERTYRADAR_API empty to run in demo mode.

# PropertyRadar — live property data (Phase 1). Empty = demo mode.
PROPERTYRADAR_API=

# Anthropic — AI deal rationale (Phase 2).
ANTHROPIC_API_KEY=

# Supabase — database (connected once keys are provided).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — Street View photos on the property page. Server-side only.
GOOGLE_MAPS_API_KEY=

# Chicago Cityscape — later phase, once access is granted.
CITYSCAPE_API=
